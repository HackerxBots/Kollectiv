# ==============================================================================
# Kollektiv configuration
# Copy to .env and fill in. Everything here is optional: subsystems degrade
# gracefully and `GET /health`/`kollektiv check` tells you what is missing.
# ==============================================================================

# --- Worker agents ------------------------------------------------------------
# A JSON list of accounts. Each entry becomes one worker in the pool.
# Two shapes are supported:
#
#   (a) HTTP endpoint + session token (recommended, no automation involved)
#       {"email":"worker1@example.com","session_token":"...","base_url":"https://api.deepseek.com/v1","model":"deepseek-chat"}
#   (b) OpenAI-compatible base_url per account
#       {"name":"w1","session_token":"sk-...","base_url":"https://api.groq.com/openai/v1","model":"llama-3.3-70b-versatile"}
#
# Kollektiv does NOT scrape or bypass paid tiers: point each account at an
# endpoint you are authorised to use.
ARENA_ACCOUNTS='[{"email":"","password":"","session_token":""}]'

# --- Shared storage (TeraBox) -------------------------------------------------
# Each entry: {"email","password","access_token","refresh_token"}
# Get access_token/refresh_token from the TeraBox Open Platform OAuth flow.
# Without tokens the client falls back to the app credentials below.
TERABOX_ACCOUNTS='[{"email":"","password":"","access_token":"","refresh_token":""}]'
TERABOX_APP_ID=
TERABOX_APP_KEY=
TERABOX_BASE_URL=https://openapi.terabox.com
TERABOX_REMOTE_ROOT=/Kollektiv
TERABOX_CHUNK_SIZE=4194304

# --- GitHub (real-time code sync layer) --------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_DEFAULT_BRANCH=main
# Archive the files touched by each push to TeraBox (off by default: it costs
# one GitHub API call per changed file).
GITHUB_PUSH_AGENT_OUTPUT=false

# --- Brain (orchestrator LLM) -------------------------------------------------
# Provider presets: deepseek, groq, openai, openrouter, together, ollama
BRAIN_PROVIDER=deepseek
BRAIN_API_KEY=
BRAIN_BASE_URL=https://api.deepseek.com
BRAIN_MODEL=deepseek-chat
BRAIN_FALLBACK_PROVIDER=groq
BRAIN_FALLBACK_API_KEY=
BRAIN_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
BRAIN_FALLBACK_MODEL=llama-3.3-70b-versatile
BRAIN_TEMPERATURE=0.2
BRAIN_MAX_TOKENS=4096
BRAIN_TIMEOUT=120

# --- Scheduling / servers -----------------------------------------------------
CRON_INTERVAL_MINUTES=15
CRON_ENABLED=true
API_PORT=8000
API_HOST=0.0.0.0
MCP_PORT=8001
MCP_HOST=0.0.0.0
# stdio | sse | streamable-http
MCP_TRANSPORT=sse

# --- Application --------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Generate one with: python -c "from src.utils.crypto import generate_secret_key; print(generate_secret_key())"
SECRET_KEY=
DATABASE_URL=sqlite:///./data/kollektiv.db
WORKSPACE_DIR=./data/workspace
CORS_ORIGINS=*
AUTO_INIT_DB=true

# --- Resilience / limits ------------------------------------------------------
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
TASK_TIMEOUT_SECONDS=900
AGENT_MAX_RETRIES=2
SESSION_REFRESH_INTERVAL=1800
ARENA_MAX_CONCURRENCY=1
ARENA_RATE_LIMIT_COOLDOWN=300
DEFAULT_AGENT_COUNT=3
MAX_AGENT_COUNT=12
STATE_HISTORY_LIMIT=200

# --- TLS ----------------------------------------------------------------------
# Set HTTP_SSL_VERIFY=false only for local debugging against self-signed certs.
# Behind a TLS-inspecting proxy, point SSL_CA_BUNDLE at the proxy's CA file.
HTTP_SSL_VERIFY=true
SSL_CA_BUNDLE=
