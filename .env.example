# ==============================================================================
# Kollektiv configuration
# Copy to .env and fill in. Everything here is optional: subsystems degrade
# gracefully and `GET /health`/`kollektiv check` tells you what is missing.
# ==============================================================================

# --- Worker agents (Arena accounts by default) --------------------------------
# Recommended: `kollektiv login` (Arena is the default provider). It stores the
# session token encrypted in the database, so this list only has to name the
# account. Other providers are optional: --provider groq|deepseek|openrouter|
# together|ollama.
# A JSON list of accounts. Each entry becomes one worker in the pool.
# Two shapes are supported:
#
#   (a) HTTP endpoint + session token (recommended, no automation involved)
#       {"email":"worker1@example.com","session_token":"...","base_url":"https://api.deepseek.com/v1","model":"deepseek-chat"}
#   (b) OpenAI-compatible base_url per account
#       {"name":"w1","session_token":"sk-...","base_url":"https://api.groq.com/openai/v1","model":"llama-3.3-70b-versatile"}
#
# Kollektiv does NOT scrape or bypass paid tiers: point each account at an
# endpoint you are authorised to use.
#
# CLI coding agents (Aider, OpenHands, Codex CLI, OpenCode, Qwen Code, …) can
# be workers too: run examples/aider_shim.py and point base_url at it, e.g.
#   {"name":"aider","session_token":"dev","base_url":"http://127.0.0.1:8099/v1","model":"aider"}
ARENA_ACCOUNTS='[{"email":"","password":"","session_token":""}]'

# --- Storage backend ----------------------------------------------------------
# auto   -> R2 when configured, else TeraBox, else the local workspace
# r2     -> Cloudflare R2 (recommended: free tier, S3 compatible, no egress)
# terabox-> pooled TeraBox accounts (9Drive-style multi-account drive)
# none   -> keep PROJECT_STATE.md and artifacts in WORKSPACE_DIR only
STORAGE_BACKEND=auto

# --- Cloudflare R2 (shared storage, free tier) --------------------------------
# 1. Cloudflare dashboard -> R2 -> Create bucket (e.g. "kollektiv")
# 2. R2 -> Manage API tokens -> Create token -> Object Read & Write
# 3. Copy the Access Key ID / Secret Access Key and the S3 endpoint below.
# The free tier includes 10 GB storage with no egress fees; pool several
# buckets/accounts into one drive with R2_ACCOUNTS (JSON list) instead:
#   [{"name":"primary","bucket":"kollektiv","access_key_id":"...",
#     "secret_access_key":"...","endpoint":"https://<acct>.r2.cloudflarestorage.com"}]
R2_ACCOUNTS='[]'
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kollektiv
R2_ENDPOINT=
R2_REGION=auto
R2_PREFIX=kollektiv
# Optional public/custom domain (R2 -> Settings -> Public access)
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRES=3600
R2_REQUEST_TIMEOUT=120
R2_FREE_TIER_GB=10

# --- Shared storage (TeraBox) -------------------------------------------------
# Each entry: {"email","password","access_token","refresh_token"}
# Get access_token/refresh_token from the TeraBox Open Platform OAuth flow.
# Without tokens the client falls back to the app credentials below.
TERABOX_ACCOUNTS='[{"email":"","password":"","access_token":"","refresh_token":""}]'
TERABOX_APP_ID=
TERABOX_APP_KEY=
TERABOX_BASE_URL=https://openapi.terabox.com
TERABOX_REMOTE_ROOT=/Kollektiv
TERABOX_CHUNK_SIZE=4194304

# --- GitHub (real-time code sync layer) --------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_DEFAULT_BRANCH=main
# Archive the files touched by each push to TeraBox (off by default: it costs
# one GitHub API call per changed file).
GITHUB_PUSH_AGENT_OUTPUT=false

# --- Brain (orchestrator LLM) -------------------------------------------------
# Provider presets: deepseek, groq, openai, openrouter, together, ollama
BRAIN_PROVIDER=deepseek
BRAIN_API_KEY=
BRAIN_BASE_URL=https://api.deepseek.com
BRAIN_MODEL=deepseek-chat
BRAIN_FALLBACK_PROVIDER=groq
BRAIN_FALLBACK_API_KEY=
BRAIN_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
BRAIN_FALLBACK_MODEL=llama-3.3-70b-versatile
BRAIN_TEMPERATURE=0.2
BRAIN_MAX_TOKENS=4096
BRAIN_TIMEOUT=120

# --- Scheduling / servers -----------------------------------------------------
CRON_INTERVAL_MINUTES=15
CRON_ENABLED=true
API_PORT=8000
API_HOST=0.0.0.0
MCP_PORT=8001
MCP_HOST=0.0.0.0
# stdio | sse | streamable-http
MCP_TRANSPORT=sse

# --- Database (Neon Postgres in production, SQLite locally) -------------------
# Neon gives you a free serverless Postgres. Paste the *pooled* connection
# string (it already contains sslmode=require); Kollektiv normalises
# postgres:// to the SQLAlchemy driver URL automatically.
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/kollektiv?sslmode=require
# Leave it unset to keep using the local SQLite file below.
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE=300

# --- Authentication (Clerk) ---------------------------------------------------
# Clerk's free tier covers 10k monthly active users. Fill in the API keys from
# the Clerk dashboard; the issuer/JWKS URL are derived from the publishable key.
#   AUTH_REQUIRED=false -> the API stays open (development / self-hosting)
#   AUTH_REQUIRED=true  -> every route except /health, /docs and /webhooks needs
#                          a valid Clerk session token (Bearer or __session cookie)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
# Comma separated origins allowed to present tokens (the token's "azp" claim).
CLERK_AUTHORIZED_PARTIES=
AUTH_REQUIRED=false
# Clerk dashboard -> Webhooks -> add endpoint -> copy the "whsec_..." secret
CLERK_WEBHOOK_SECRET=

# --- Connectors: the services you already use ---------------------------------
# Each connector is optional; `kollektiv connectors` shows what is missing.
# 1) Google Workspace (Gmail + Calendar + Drive) — one OAuth refresh token.
#    Create an OAuth client (Desktop app) in Google Cloud, mint a refresh token
#    with these scopes, then paste the three values:
#      https://www.googleapis.com/auth/gmail.readonly
#      https://www.googleapis.com/auth/gmail.send
#      https://www.googleapis.com/auth/calendar
#      https://www.googleapis.com/auth/drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# 2) Notion — create an internal integration (ntn_...) and share the pages with it.
NOTION_TOKEN=
NOTION_VERSION=2022-06-28
# 3) Outbound events — comma separated URLs (Slack/Discord incoming webhooks,
#    n8n/Activepieces/Zapier catch hooks, your own service). Kollektiv POSTs
#    {"source","text","event"} after every orchestrated run.
EVENT_WEBHOOKS=
# 4) Any other JSON API, declaratively (no code): a JSON list, one entry per
#    service, one action per endpoint. See src/connectors/rest.py for the schema.
#    [{"name":"slack","category":"chat","base_url":"https://slack.com/api",
#      "auth":"bearer","token":"xoxb-…",
#      "actions":[{"name":"post_message","method":"POST","path":"/chat.postMessage",
#                  "dangerous":true,"params":{"channel":"Channel id","text":"Body"}}]}]
CUSTOM_CONNECTORS='[]'

# --- Email notifications (Resend) ---------------------------------------------
# Resend's free tier sends 3k emails/month. Recipients receive the run summary
# ("completed"/"failed") and operational alerts.
RESEND_API_KEY=
RESEND_FROM=Kollektiv <onboarding@resend.dev>
RESEND_BASE_URL=https://api.resend.com
NOTIFY_EMAILS=
NOTIFY_ON_RUN_COMPLETION=true
NOTIFY_ON_FAILURE_ONLY=false
APP_BASE_URL=http://localhost:8000

# --- Application --------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Generate one with: python -c "from src.utils.crypto import generate_secret_key; print(generate_secret_key())"
SECRET_KEY=
DATABASE_URL=sqlite:///./data/kollektiv.db
WORKSPACE_DIR=./data/workspace
CORS_ORIGINS=*
AUTO_INIT_DB=true

# --- Resilience / limits ------------------------------------------------------
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
TASK_TIMEOUT_SECONDS=900
AGENT_MAX_RETRIES=2
SESSION_REFRESH_INTERVAL=1800
ARENA_MAX_CONCURRENCY=1
ARENA_RATE_LIMIT_COOLDOWN=300
DEFAULT_AGENT_COUNT=3
MAX_AGENT_COUNT=12
STATE_HISTORY_LIMIT=200

# --- TLS ----------------------------------------------------------------------
# Set HTTP_SSL_VERIFY=false only for local debugging against self-signed certs.
# Behind a TLS-inspecting proxy, point SSL_CA_BUNDLE at the proxy's CA file.
HTTP_SSL_VERIFY=true
SSL_CA_BUNDLE=
