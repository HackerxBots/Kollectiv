# The wheel carries the dashboard through [tool.setuptools.package-data] in
# pyproject.toml; the sdist needs its own list. web/ is a static site (Cloudflare
# Pages deploys it directly), not a Python package, which is why both lists exist.
include web/index.html web/_headers web/_redirects web/README.md
recursive-include web/assets *

# Documentation and community files belong in the sdist so a maintainer can
# build and release from it without cloning.
include CHANGELOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md DECISIONS.md
include docker-compose.yml Dockerfile .env.example
# *.json covers the example sponsor catalogue (docs/sponsors.example.json).
recursive-include docs *.md *.json
recursive-include scripts *.py
recursive-include examples *.py *.md
recursive-include .github *.yml *.md
